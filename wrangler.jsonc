{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ichannel",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "vars": {
    "ENVIRONMENT": "production",
    "PMS_NAME": "iChannel Vacation Rental PMS",
    "API_VERSION": "v1"
  }
}
